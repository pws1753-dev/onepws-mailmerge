{
  "manifest_version": 3,
  "name": "OnePWS Mail Merge",
  "short_name": "OnePWS",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "Personal Gmail mail merge by OnePWS. Import contacts, preview personalized emails, and send from your own account.",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://mailmerge.onepws.com/*"
  ],
  "oauth2": {
    "client_id": "451076729897-7n743ad7qonka3lvecbti49ggggafv6u.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/spreadsheets.readonly"
    ]
  },
  "background": {
    "service_worker": "background_service.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open OnePWS Mail Merge",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail-launcher.js"
      ],
      "css": [
        "onepws-gmail.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon-48.png",
        "assets/fonts/BeVietnamPro-Medium.ttf"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src https://gmail.googleapis.com https://www.googleapis.com https://sheets.googleapis.com https://mailmerge.onepws.com; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "key": ""
}

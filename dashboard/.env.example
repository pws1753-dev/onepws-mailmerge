# Never commit the real .env file. Set these in Hostinger's Node.js environment panel.
PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb+srv://...
MONGODB_DB=onepws_mailmerge
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-value
# Set a unique, long password before opening the dashboard publicly.
DASHBOARD_PASSWORD=replace-with-a-unique-long-password
# Comma-separated CORS origins allowed to post events from the extension.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://eehocacgefdeecljoadpomjmdojdeaei
# Base URL used in tracking/unsubscribe links after domain deployment.
PUBLIC_BASE_URL=https://mailmerge.onepws.com
